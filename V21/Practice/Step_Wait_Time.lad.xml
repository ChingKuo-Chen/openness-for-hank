<?xml version="1.0" encoding="utf-8"?>
<Lad kind="FC" name="Step_Wait_Time" number="38" comment="練習區塊 Step_Wait_Time（LAD）。可攜腳位，不依賴廠端全域標籤。">
  <Interface>
    <Section name="Input">
      <Member name="stop" type="Bool"  comment="停止" />
      <Member name="Reset" type="Bool"  comment="復位" />
      <Member name="clear_done" type="Bool"  comment="InOut：clear_done（Bool）" />
    </Section>
    <Section name="InOut">
      <Member name="step" type="Struct">
        <Member name="exec" type="Bool"  comment="InOut：exec（Bool）" />
        <Member name="busy" type="Bool"  comment="InOut：busy（Bool）" />
        <Member name="done" type="Bool"  comment="InOut：done（Bool）" />
        <Member name="error" type="Bool"  comment="InOut：error（Bool）" />
        <Member name="exec_edge" type="Bool"  comment="InOut：exec_edge（Bool）" />
        <Member name="max_time" type="Time"  comment="InOut：max_time（Time）" />
        <Member name="max_timer" type="IEC_TIMER"  comment="InOut：max_timer（IEC_TIMER）" />
      </Member>
    </Section>
  </Interface>
  <Network title="abort actions" comment="1. abort actions">
    <Fork>
      <Series>
        <Contact var="stop" />
        <Fork>
          <Series>
            <RCoil var="step.exec" />
          </Series>
          <Series>
            <RCoil var="step.busy" />
          </Series>
        </Fork>
      </Series>
      <Series>
        <Contact var="Reset" />
        <Fork>
          <Series>
            <RCoil var="step.exec" />
          </Series>
          <Series>
            <RCoil var="step.busy" />
          </Series>
          <Series>
            <RCoil var="step.done" />
          </Series>
          <Series>
            <RCoil var="step.error" />
          </Series>
        </Fork>
      </Series>
    </Fork>
  </Network>
  <Network title="timed action while busy" comment="2. timed action while busy">
    <Series>
      <Contact var="step.busy" />
      <CoilTON var="step.max_timer" time_type="Time">
        <In port="value" var="step.max_time" />
      </CoilTON>
    </Series>
  </Network>
  <Network title="time reached, mark done" comment="3. time reached, mark done">
    <Series>
      <Contact var="step.max_timer.Q" />
      <Fork>
        <Series>
          <RCoil var="step.busy" />
        </Series>
        <Series>
          <SCoil var="step.done" />
        </Series>
        <Series>
          <RCoil var="step.error" />
        </Series>
      </Fork>
    </Series>
  </Network>
  <Network title="clear done" comment="4. clear done">
    <Series>
      <Contact var="clear_done" />
      <RCoil var="step.done" />
    </Series>
  </Network>
</Lad>
