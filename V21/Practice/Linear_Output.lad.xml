<?xml version="1.0" encoding="utf-8"?>
<!-- Linear command: sync_ramp * ratio * factor / 100, overflow flag, scaled to ref_max. -->
<Lad kind="FC" name="Linear_Output" number="22" comment="Linear command: sync_ramp * ratio * factor / 100, overflow flag, scaled to ref_max.">
  <Interface>
    <Section name="Input">
      <Member name="sync_ramp" type="Real"  comment="暫存：sync_ramp（Real）" />
      <Member name="ratio" type="Real"  comment="暫存：ratio（Real）" />
      <Member name="ref_max" type="Real"  comment="暫存：ref_max（Real）" />
      <Member name="factor" type="Real"  comment="暫存：factor（Real）" />
    </Section>
    <Section name="Output">
      <Member name="cmd_ovrflow" type="Bool"  comment="暫存：cmd_ovrflow（Bool）" />
      <Member name="cmd_ref" type="Real"  comment="暫存：cmd_ref（Real）" />
    </Section>
    <Section name="Temp">
      <Member name="norm_out" type="Real"  comment="暫存：norm_out（Real）" />
      <Member name="fixed_norm_out" type="Real"  comment="暫存：fixed_norm_out（Real）" />
    </Section>
  </Interface>
  <Network title="linear command" comment="1. linear command">
    <Fork>
      <Series>
        <Box name="Calc" SrcType="Real" card="4" equation="in1 * in2  *in3 / in4">
          <In port="in1" var="sync_ramp" />
          <In port="in2" var="ratio" />
          <In port="in3" var="factor" />
          <In port="in4" const="100.0" type="Real" />
          <Out port="out" var="norm_out" />
        </Box>
        <Box name="OutRange" SrcType="Real">
          <In port="min" const="0.0" type="Real" />
          <In port="in" var="norm_out" />
          <In port="max" const="1.0" type="Real" />
        </Box>
        <Coil var="cmd_ovrflow" />
      </Series>
      <Series>
        <Box name="Scale_X" SrcType="Real" DestType="Real" eno="false">
          <In port="min" const="0.0" type="Real" />
          <In port="value" var="norm_out" />
          <In port="max" var="ref_max" />
          <Out port="out" var="cmd_ref" />
        </Box>
      </Series>
    </Fork>
  </Network>
</Lad>
