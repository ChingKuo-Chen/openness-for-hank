FUNCTION "getDBInfo" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 1.0
// --- 介面腳位 ---
VAR_IN_OUT
    db_num : Int;
    info_db_num : Int;
END_VAR
// --- 主要邏輯 ---
// 依 23019 原版算法改寫；細節見 Practice\SclDump\getDBInfo.txt
BEGIN
    info_db_num := db_num;
END_FUNCTION
