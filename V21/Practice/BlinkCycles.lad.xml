          <Param name="s_in" section="Input" type="Bool" var="s_in" />
          <Param name="cur" section="InOut" type="Struct" var="b1" />
          <Param name="next" section="InOut" type="Struct" var="b2" />
          <Param name="s_out" section="InOut" type="Bool" var="s_out" />
        </Call>
      </Series>
      <Series>
