  <Network title="load on/off times" comment="1. load on/off times">
    <Fork>
      <Series><Box name="Move" eno="false"><In port="in" var="tm1_on" /><Out port="out1" var="b1.tm_on" /></Box></Series>
      <Series><Box name="Move" eno="false"><In port="in" var="tm1_off" /><Out port="out1" var="b1.tm_off" /></Box></Series>
      <Series><Box name="Move" eno="false"><In port="in" var="tm2_on" /><Out port="out1" var="b2.tm_on" /></Box></Series>
      <Series><Box name="Move" eno="false"><In port="in" var="tm2_off" /><Out port="out1" var="b2.tm_off" /></Box></Series>
      <Series><Box name="Move" eno="false"><In port="in" var="tm3_on" /><Out port="out1" var="b3.tm_on" /></Box></Series>
      <Series><Box name="Move" eno="false"><In port="in" var="tm3_off" /><Out port="out1" var="b3.tm_off" /></Box></Series>
