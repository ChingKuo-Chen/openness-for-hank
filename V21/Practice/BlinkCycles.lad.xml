      <Series><Box name="Move" eno="false"><In port="in" var="tm4_off" /><Out port="out1" var="b4.tm_off" /></Box></Series>
    </Fork>
  </Network>

  <Network title="start at stage 1" comment="2. start at stage 1">
    <Series>
      <PContact var="s_in" mem="in_m" />
      <SCoil var="b1.activate" />
    </Series>
  </Network>

