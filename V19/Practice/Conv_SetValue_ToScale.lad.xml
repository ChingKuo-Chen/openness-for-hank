<?xml version="1.0" encoding="utf-8"?>
<!-- Clamp setValue, normalize to 0..1, scale to scaleTo. -->
<Lad kind="FC" name="Conv_SetValue_ToScale" number="21" comment="Clamp setValue, normalize to 0..1, scale to scaleTo.">
  <Interface>
    <Section name="Input">
      <Member name="maxSetValue" type="Real"  comment="暫存：maxSetValue（Real）" />
      <Member name="scaleTo" type="Real"  comment="暫存：scaleTo（Real）" />
    </Section>
    <Section name="InOut">
      <Member name="setValue" type="Real"  comment="暫存：setValue（Real）" />
      <Member name="scaleValue" type="Real"  comment="暫存：scaleValue（Real）" />
    </Section>
    <Section name="Temp">
      <Member name="norm" type="Real"  comment="暫存：norm（Real）" />
