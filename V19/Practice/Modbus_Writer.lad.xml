<?xml version="1.0" encoding="utf-8"?>
<!-- One Modbus write via MB_MASTER; RTU_Data / ComStatus inlined. -->
<Lad kind="FB" name="Modbus_Writer" number="87" comment="One Modbus write via MB_MASTER; RTU_Data / ComStatus inlined.">
  <Interface>
    <Section name="Input">
      <Member name="enable" type="Bool"  comment="使能" />
      <Member name="reset" type="Bool"  comment="復位" />
      <Member name="mb_addr" type="UInt"  comment="靜態：mb_addr（UInt）" />
    </Section>
    <Section name="InOut">
      <Member name="my_MB_Master" type="MB_MASTER"  comment="靜態：my_MB_Master（MB_MASTER）" />
      <Member name="CMD" type="Struct">
        <Member name="RTU_Mode" type="USInt"  comment="靜態：RTU_Mode（USInt）" />
        <Member name="RTU_Data_Addr" type="UDInt"  comment="靜態：RTU_Data_Addr（UDInt）" />
        <Member name="RTU_Data_Len" type="Int"  comment="靜態：RTU_Data_Len（Int）" />
        <Member name="swap" type="Bool"  comment="靜態：swap（Bool）" />
        <Member name="to_write" type="Bool"  comment="靜態：to_write（Bool）" />
        <Member name="valid" type="Bool"  comment="資料有效" />
        <Member name="raw_value" type="DInt"  comment="靜態：raw_value（DInt）" />
        <Member name="total_count" type="DInt"  comment="靜態：total_count（DInt）" />
        <Member name="failed_count" type="DInt"  comment="靜態：failed_count（DInt）" />
      </Member>
      <Member name="error" type="Bool"  comment="靜態：error（Bool）" />
    </Section>
    <Section name="Static">
      <Member name="RawDInt" type="DInt"  comment="靜態：RawDInt（DInt）" />
      <Member name="stat" type="Struct">
        <Member name="done" type="Bool"  comment="靜態：done（Bool）" />
        <Member name="busy" type="Bool"  comment="靜態：busy（Bool）" />
        <Member name="error" type="Bool"  comment="靜態：error（Bool）" />
        <Member name="status" type="Word"  comment="靜態：status（Word）" />
      </Member>
      <Member name="req" type="Bool"  comment="靜態：req（Bool）" />
    </Section>
  </Interface>

  <Network title="write one command" comment="1. write one command">
    <Fork>
      <Series>
        <Contact var="enable" />
        <Contact var="CMD.to_write" />
        <Coil var="req" />
      </Series>
      <Series>
        <Contact var="enable" />
        <Contact var="CMD.to_write" />
        <Call name="Comm_Swap" type="FC">
          <Param name="swap" section="Input" type="Bool" var="CMD.swap" />
          <Param name="len" section="Input" type="Int" var="CMD.RTU_Data_Len" />
          <Param name="raw" section="Input" type="DInt" var="CMD.raw_value" />
          <Param name="final" section="Output" type="DInt" var="RawDInt" />
        </Call>
      </Series>
      <Series>
        <Contact var="enable" />
        <Contact var="CMD.to_write" />
        <Box name="MB_MASTER" instance="my_MB_Master">
          <In port="REQ" var="req" />
          <In port="MB_ADDR" var="mb_addr" />
          <In port="MODE" var="CMD.RTU_Mode" />
          <In port="DATA_ADDR" var="CMD.RTU_Data_Addr" />
          <In port="DATA_LEN" var="CMD.RTU_Data_Len" />
          <In port="DATA_PTR" var="RawDInt" />
          <Out port="DONE" var="stat.done" />
          <Out port="BUSY" var="stat.busy" />
          <Out port="ERROR" var="stat.error" />
          <Out port="STATUS" var="stat.status" />
          <Open port="eno" />
        </Box>
      </Series>
      <Series>
        <Contact var="enable" />
        <Contact var="CMD.to_write" />
        <Contact var="stat.busy" negated="true" />
        <Box name="Inc" DestType="DInt" eno="false">
          <In port="operand" var="CMD.total_count" />
        </Box>
      </Series>
      <Series>
        <Contact var="enable" />
        <Contact var="CMD.to_write" />
        <Contact var="stat.done" />
        <Fork>
          <Series><RCoil var="CMD.to_write" /></Series>
          <Series><RCoil var="error" /></Series>
          <Series><SCoil var="CMD.valid" /></Series>
        </Fork>
      </Series>
      <Series>
        <Contact var="enable" />
        <Contact var="CMD.to_write" />
        <Contact var="stat.error" />
        <Fork>
          <Series>
            <Box name="Inc" DestType="DInt" eno="false">
              <In port="operand" var="CMD.failed_count" />
            </Box>
          </Series>
          <Series><SCoil var="error" /></Series>
          <Series><RCoil var="CMD.valid" /></Series>
        </Fork>
      </Series>
    </Fork>
  </Network>

  <Network title="reset counters" comment="2. reset counters">
    <Series>
      <Contact var="reset" />
      <Box name="Move" card="2" eno="false">
        <In port="in" const="0" type="DInt" />
        <Out port="out1" var="CMD.total_count" />
        <Out port="out2" var="CMD.failed_count" />
      </Box>
    </Series>
  </Network>
</Lad>
