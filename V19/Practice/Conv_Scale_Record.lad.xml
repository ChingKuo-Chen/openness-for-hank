<?xml version="1.0" encoding="utf-8"?>
<Lad kind="FC" name="Conv_Scale_Record" number="59" comment="練習區塊 Conv_Scale_Record（LAD）。可攜腳位，不依賴廠端全域標籤。">
  <Interface>
    <Section name="Input">
      <Member name="fdbk_record" type="Struct">
        <Member name="norm" type="Real"  comment="InOut：norm（Real）" />
      </Member>
    </Section>
    <Section name="InOut">
      <Member name="scale_record" type="Struct">
        <Member name="min" type="Real"  comment="InOut：min（Real）" />
        <Member name="max" type="Real"  comment="InOut：max（Real）" />
        <Member name="display" type="Real"  comment="InOut：display（Real）" />
      </Member>
    </Section>
  </Interface>
  <Network title="call Scale_X" comment="1. call Scale_X">
    <Series>
      <Box name="Scale_X" SrcType="Real" DestType="Real" eno="false">
        <In port="min" var="scale_record.min" />
        <In port="value" var="fdbk_record.norm" />
        <In port="max" var="scale_record.max" />
        <Out port="out" var="scale_record.display" />
      </Box>
    </Series>
  </Network>
</Lad>
