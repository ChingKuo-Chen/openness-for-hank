// =============================================================================
// 區塊：Enc_Accu（FC）
// 23019 參考：1 個邏輯段。詳見 Practice\SclDump\Enc_Accu.txt
// =============================================================================

FUNCTION "Enc_Accu" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 1.0
// --- 介面腳位 ---
VAR_INPUT
    diff : Real;
END_VAR
// --- 介面腳位 ---
VAR_IN_OUT
    accu : LReal;
END_VAR
// --- 主要邏輯 ---
// 依 23019 原版算法改寫；細節見 Practice\SclDump\Enc_Accu.txt
BEGIN
    accu := accu + REAL_TO_LREAL(diff);
END_FUNCTION
