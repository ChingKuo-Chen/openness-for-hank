// =============================================================================
// 區塊：Switch（FC）
// 23019 參考：1 個邏輯段。詳見 Practice\SclDump\Switch.txt
// =============================================================================

FUNCTION "Switch" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 1.0
// --- 介面腳位 ---
VAR_IN_OUT
    pb : Bool;
    pb_edge : Bool;
    sw : Bool;
END_VAR
// --- 主要邏輯 ---
// 依 23019 原版算法改寫；細節見 Practice\SclDump\Switch.txt
BEGIN
    IF pb AND (pb <> pb_edge) THEN
        sw := NOT sw;
    END_IF;
    pb_edge := pb;
END_FUNCTION
