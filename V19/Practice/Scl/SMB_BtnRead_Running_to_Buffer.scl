FUNCTION "SMB_BtnRead_Running_to_Buffer" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 1.0
// --- 介面腳位 ---
VAR_IN_OUT
    src_a : Real;
    src_b : Real;
    src_c : Real;
    src_d : Real;
    dst_a : Real;
    dst_b : Real;
    dst_c : Real;
    dst_d : Real;
END_VAR
// --- 主要邏輯 ---
// 依 23019 原版算法改寫；細節見 Practice\SclDump\SMB_BtnRead_Running_to_Buffer.txt
BEGIN
    dst_a := src_a;
    dst_b := src_b;
    dst_c := src_c;
    dst_d := src_d;
END_FUNCTION
