<?xml version="1.0" encoding="utf-8"?>
<!-- Zigbee as Modbus master sequencer (114-part original reduced to load+query). -->
<Lad kind="FB" name="Modbus_Comm_PLC_Zigbee_Modbus" number="123" comment="Zigbee as Modbus master sequencer (114-part original reduced to load+query).">
  <Interface>
    <Section name="Input">
      <Member name="first_scan" type="Bool"  comment="靜態：first_scan（Bool）" />
      <Member name="reset" type="Bool"  comment="復位" />
      <Member name="mb_addr" type="UInt"  comment="靜態：mb_addr（UInt）" />
    </Section>
    <Section name="InOut">
      <Member name="my_MB_Master" type="MB_MASTER"  comment="靜態：my_MB_Master（MB_MASTER）" />
      <Member name="watch_dog" type="Int"  comment="靜態：watch_dog（Int）" />
    </Section>
    <Section name="Static">
      <Member name="comm_load" type="Bool"  comment="靜態：comm_load（Bool）" />
      <Member name="query_idx" type="UInt"  comment="靜態：query_idx（UInt）" />
      <Member name="Drive" type="Modbus_Delta_Drive_N1_M"  comment="靜態：Drive（Modbus_Delta_Drive_N1_M）" />
    </Section>
  </Interface>
  <Network title="load pulse" comment="1. load pulse">
    <Fork>
      <Series>
        <Contact var="first_scan" />
        <SCoil var="comm_load" />
      </Series>
      <Series>
        <Contact var="Drive.finish" />
        <RCoil var="comm_load" />
      </Series>
    </Fork>
  </Network>
  <Network title="query" comment="2. query">
    <Series>
      <Call name="Modbus_Delta_Drive_N1_M" type="FB" instance="Drive" scope="LocalVariable">
        <Param name="enable" section="Input" type="Bool" var="comm_load" />
        <Param name="reset" section="Input" type="Bool" var="reset" />
        <Param name="mb_addr" section="Input" type="UInt" var="mb_addr" />
        <Param name="first_scan" section="Input" type="Bool" var="first_scan" />
        <Param name="my_MB_Master" section="InOut" type="MB_MASTER" var="my_MB_Master" />
      </Call>
    </Series>
  </Network>
  <Network title="watchdog" comment="3. watchdog">
    <Series>
      <Box name="Inc" DestType="Int" eno="false">
        <In port="operand" var="watch_dog" />
      </Box>
    </Series>
  </Network>
</Lad>
